rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    match /products/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /payment-methods/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /categories/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    match /brands/{allPaths=**} {
      allow read: if true;
      allow write: if false;
    }
    // Chat images are private. The browser never reads or writes Storage
    // directly; /api/chat/image and /api/chat/send use the Admin SDK, which
    // bypasses these rules and enforces conversation ownership itself.
    match /chat/{allPaths=**} {
      allow read, write: if false;
    }
  }
}
